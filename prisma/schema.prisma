generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User{
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  password String 
  usage Float 
  files File[]
}

model File {
  id     Int    @id @default(autoincrement())
  key    String
  userId Int
  user   User   @relation(fields: [userId], references: [id]) 
}
